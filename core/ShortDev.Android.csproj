<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net11.0-android</TargetFrameworks>
		<SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>0.6.0-beta</Version>
		<LangVersion>15</LangVersion>
	</PropertyGroup>

	<PropertyGroup>
		<Description>Utils for .NET Android development.</Description>
		<Authors>ShortDevelopment</Authors>
		<RepositoryUrl>https://github.com/ShortDevelopment/ShortDev.Android</RepositoryUrl>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.3" />
		<None Include="../LICENSE.txt" Pack="true" PackagePath="/" />
		<None Include="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>
</Project>